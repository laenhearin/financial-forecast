/**
 * Offline: npm run nessie:history. Builds the six-month demo history (seed v2) from
 * data/nessie-demo/plan.json and src/lib/demo-history/personas.ts, writes
 * data/nessie-demo/history-v2.json for review, and prints a summary. No network calls.
 */
import { readFile, writeFile } from "node:fs/promises";
import { generatePersonaHistory, historyWindowStart, HISTORY_MONTHS, HISTORY_SEED_ID, type PlanProfileInput } from "../src/lib/demo-history/generate";
import { PERSONAS } from "../src/lib/demo-history/personas";
import { parseSeedTag, SPENDING_CATEGORIES } from "../src/lib/spending-categories";

const root = new URL("../data/nessie-demo/", import.meta.url);
const plan = JSON.parse(await readFile(new URL("plan.json", root), "utf8")) as { asOfDate: string; profiles: (PlanProfileInput & { label: string })[] };
const dollars = (cents: number) => `$${Math.round(cents / 100).toLocaleString("en-US")}`;

const profiles = PERSONAS.map(persona => {
  const profile = plan.profiles.find(row => row.slug === persona.slug);
  if (!profile) throw new Error(`plan.json has no profile ${persona.slug}.`);
  return { label: profile.label, ...generatePersonaHistory(profile, persona, plan.asOfDate) };
});

await writeFile(new URL("history-v2.json", root), JSON.stringify({
  seedId: HISTORY_SEED_ID,
  asOfDate: plan.asOfDate,
  windowStart: historyWindowStart(plan.asOfDate),
  note: "Generated by scripts/generate-nessie-history.mts. Synthetic demo data; amounts in cents, written to Nessie as whole dollars.",
  profiles: profiles.map(({ slug, startCheckingCents, startSavingsCents, lowestCheckingCents, records }) => ({
    slug, startCheckingCents, startSavingsCents, lowestCheckingCents,
    records: records.map(({ seq, account, kind, date, amountCents, label, tag, description }) => ({ seq, account, kind, date, amountCents, label, tag, description })),
  })),
}, null, 2) + "\n");

console.log(`Window ${historyWindowStart(plan.asOfDate)} to ${plan.asOfDate}. Wrote data/nessie-demo/history-v2.json.\n`);
let total = 0;
for (const profile of profiles) {
  total += profile.records.length;
  const spend = new Map<string, number>();
  const flows = new Map<string, number>();
  for (const row of profile.records) {
    const parsed = parseSeedTag(row.description)!;
    flows.set(parsed.flow, (flows.get(parsed.flow) ?? 0) + row.amountCents);
    if (parsed.flow === "spend") spend.set(parsed.category!, (spend.get(parsed.category!) ?? 0) + row.amountCents);
  }
  console.log(`${profile.label} (${profile.slug}): ${profile.records.length} new records, ~${Math.round(profile.records.length / HISTORY_MONTHS)} a month`);
  console.log(`  checking ${dollars(profile.startCheckingCents)} six months ago, lowest ${dollars(profile.lowestCheckingCents)}; savings ${dollars(profile.startSavingsCents)} six months ago`);
  console.log(`  six-month totals (new records only): ${[...flows].map(([flow, cents]) => `${flow} ${dollars(cents)}`).join(", ")}`);
  console.log(`  new everyday spending a month: ${[...spend].map(([category, cents]) => `${SPENDING_CATEGORIES[category as keyof typeof SPENDING_CATEGORIES].label} ${dollars(cents / HISTORY_MONTHS)}`).join(", ")}`);
}
console.log(`\n${total} new records in total.`);
