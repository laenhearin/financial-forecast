NESSIE_API_KEY=
NESSIE_BASE_URL=
# Only scripts/nessie-smoke.mts uses this; the app picks the customer on its Profile page.
NESSIE_ACCOUNT_ID=

# --- AI layer (Gemini). Server-only: never prefix these with NEXT_PUBLIC_. ---
# Key from https://aistudio.google.com/apikey. Leave empty to run every AI surface on template text.
GEMINI_API_KEY=
# Model IDs are configurable so they can be swapped on demo day without a code change.
# MAIN: ask box (tool calling + streaming).
GEMINI_MODEL_MAIN=gemini-3.8-flash
# FAST: Purchase Advisor explanation, Big Purchase summary, Cash Back categories.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# FALLBACK: tried once when the first model is rate limited or unavailable.
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
# Master switch.
AI_ENABLED=true
# true skips the API and always uses template text (to test the fallback path).
AI_FORCE_FALLBACK=false
AI_REQUEST_TIMEOUT_MS=15000
AI_CACHE_TTL_MS=600000
AI_CACHE_MAX_ENTRIES=200
AI_ROUTE_RATE_LIMIT_PER_MIN=30
