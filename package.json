{
  "name": "financial-forecast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env WATCHPACK_POLLING=true next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:smoke": "node scripts/ai-smoke.mts",
    "ai:burst": "node scripts/ai-burst.mts",
    "nessie:read": "node --conditions=react-server --experimental-transform-types --no-warnings --import ./scripts/resolve-app-imports.mjs --env-file=.env.local scripts/read-nessie-profile.mts",
    "nessie:history": "node --conditions=react-server --experimental-transform-types --no-warnings --import ./scripts/resolve-app-imports.mjs scripts/generate-nessie-history.mts",
    "nessie:seed-history": "node --conditions=react-server --experimental-transform-types --no-warnings --import ./scripts/resolve-app-imports.mjs --env-file=.env.local scripts/seed-nessie-history.mts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.30.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
